{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Permissions for the main window. Only the listed app commands and minimal core features are allowed. No fs, shell, or http plugin access.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:app:allow-version",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-is-focused",
    "core:path:default",
    "allow-app-info",
    "allow-clipboard-write",
    "allow-open-external",
    "allow-open-log-folder",
    "allow-connection-list",
    "allow-connection-test",
    "allow-connection-save",
    "allow-connection-remove",
    "allow-connection-set-active",
    "allow-connection-add-bucket",
    "allow-connection-remove-bucket",
    "allow-connection-set-public-url",
    "allow-connection-toggle-favorite",
    "allow-bucket-list",
    "allow-object-list",
    "allow-object-search",
    "allow-object-head",
    "allow-prefix-size",
    "allow-folder-create",
    "allow-preview-text",
    "allow-media-token",
    "allow-delete-preview",
    "allow-delete-execute",
    "allow-move-preview",
    "allow-move-execute",
    "allow-pick-upload-files",
    "allow-pick-upload-folder",
    "allow-upload-prepare",
    "allow-upload-start",
    "allow-download-start",
    "allow-transfer-subscribe",
    "allow-transfer-control",
    "allow-transfer-control-many",
    "allow-transfer-pause-all",
    "allow-transfer-clear-finished",
    "allow-transfer-history",
    "allow-transfer-show",
    "allow-settings-get",
    "allow-settings-set",
    "allow-settings-choose-download-dir",
    "allow-settings-reset",
    "allow-history-clear",
    "allow-settings-choose-activity-dir",
    "allow-open-activity-folder",
    "allow-activity-note",
    "allow-activity-reset-dir",
    "allow-log-copy-path",
    "allow-activity-export-csv"
  ]
}
